// Recursos do executavel: icone e informacoes de versao (aba "Detalhes" das propriedades do arquivo).
#include <winver.h>

1 ICON "../assets/wdc.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "Projeto de recompilacao (nao oficial)"
            VALUE "FileDescription", "World Driver Championship - Leo Build"
            VALUE "FileVersion", "0.1.1-canary"
            VALUE "InternalName", "WorldDriverChampionship"
            VALUE "OriginalFilename", "WorldDriverChampionship.exe"
            VALUE "ProductName", "World Driver Championship (recompilacao para PC)"
            VALUE "ProductVersion", "0.1.1-canary"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END
