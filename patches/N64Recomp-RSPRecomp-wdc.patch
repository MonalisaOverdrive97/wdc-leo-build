+static std::unordered_set<uint32_t> g_label_hooks;   // WDC patch: enderecos que recebem RSP_LABEL_HIT(addr) (contadores de execucao)
+
+bool cop0_reg_is_dma(int cop0_reg) {
+    switch (static_cast<Cop0Reg>(cop0_reg)) {
+    case Cop0Reg::RSP_COP0_SP_MEM_ADDR:
+    case Cop0Reg::RSP_COP0_SP_DRAM_ADDR:
+    case Cop0Reg::RSP_COP0_SP_RD_LEN:
+    case Cop0Reg::RSP_COP0_SP_WR_LEN:
+        return true;
+    default:
+        return false;
+    }
+}
